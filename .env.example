# Copy to backend/.env for local backend development. Never commit real secrets.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Alternatively set ADMIN_PASSWORD_HASH to a Werkzeug password hash and leave ADMIN_PASSWORD blank.
ADMIN_PASSWORD_HASH=
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
PORT=5000
# For production use managed PostgreSQL (e.g. Supabase); local SQLite is development-only.
DATABASE_URL=
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
